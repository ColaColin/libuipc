+    // s19 (round 7): the two-hinges-per-thread twin. The blocked kernel runs
+    // 255 registers at <<<ceil(n/256), 256>>> -- at the machine's full
+    // 256-thread/SM register-limited occupancy, one block per SM -- and the
+    // crease-press hinge count (~9.5k) nearly exactly fills that capacity, so
+    // no launch-geometry change can add concurrent chains. This arm instead
+    // gives each thread a second independent hinge: the two stencils' dEdx /
+    // ddEddx / QL chains interleave inside one instruction stream (the fused
+    // make_spd_translation_free_4x3_blocked_pair), overlapping the divisions,
+    // hypots and local-memory round trips that s16 measured as the QL's
+    // latency half (the solve runs at 52 % of its FP64-issue floor).
+    // Per-hinge arithmetic is unchanged -- same expressions, same order, the
+    // pairing is a scheduling change only -- so G and H are bit-identical to
+    // the single-hinge kernel (UIPC_PDSB_OCC_VERIFY proves it on device).
+    // The block dim is fixed at 128, not best_block_dim: the pair kernel
+    // serves ceil(n/2) threads and needs ceil(n/2)/128 = ceil(n/256) blocks
+    // to keep today's one-block-per-SM fill (the occupancy API would return
+    // 256 and leave half the SMs empty).
+    // UIPC_PDSB_OCC=0 restores the single-hinge kernel everywhere.
+    template <int Proj, int Solver, int SymAsm = 2>
+    __global__ void StrainPlasticDiscreteShellBending_do_compute_gradient_hessian_pair_kernel(
+        cuda_tool::BufferView<Vector4i>        stencils,
+        cuda_tool::BufferView<Float>           bending_stiffnesses,
+        cuda_tool::BufferView<Float>           theta_bars,
+        cuda_tool::BufferView<Float>           h_bars,
+        cuda_tool::BufferView<Float>           V_bars,
+        cuda_tool::BufferView<Float>           L0s,
+        cuda_tool::CBufferView<Vector3>        xs,
+        cuda_tool::DoubletVectorView<Float, 3> G3s,
+        cuda_tool::TripletMatrixView<Float, 3> H3x3s,
+        Float                                  dt,
+        bool                                   gradient_only,
+        int                                    n)
+    {
+        int half = (n + 1) / 2;
+        int i0   = blockIdx.x * blockDim.x + threadIdx.x;
+        if(i0 >= half)
+            return;
+        int  i1   = i0 + half;
+        bool has1 = i1 < n;  // false only for the last thread when n is odd
+
+        Vector4i sa          = stencils(i0);
+        Float    kappa_a     = bending_stiffnesses(i0);
+        Float    L0_a        = L0s(i0);
+        Float    h_bar_a     = h_bars(i0);
+        Float    theta_bar_a = theta_bars(i0);
+        Float    V_bar_a     = V_bars(i0);
+        // the degenerate unpaired thread computes on a duplicate of its own
+        // (in-bounds) inputs and discards the second write
+        Vector4i sb          = has1 ? stencils(i1) : sa;
+        Float    kappa_b     = has1 ? bending_stiffnesses(i1) : kappa_a;
+        Float    L0_b        = has1 ? L0s(i1) : L0_a;
+        Float    h_bar_b     = has1 ? h_bars(i1) : h_bar_a;
+        Float    theta_bar_b = has1 ? theta_bars(i1) : theta_bar_a;
+        Float    V_bar_b     = has1 ? V_bars(i1) : V_bar_a;
+
+        Vector3 x0a = xs(sa[0]);
+        Vector3 x1a = xs(sa[1]);
+        Vector3 x2a = xs(sa[2]);
+        Vector3 x3a = xs(sa[3]);
+        Vector3 x0b = xs(sb[0]);
+        Vector3 x1b = xs(sb[1]);
+        Vector3 x2b = xs(sb[2]);
+        Vector3 x3b = xs(sb[3]);
+
+        Float Vdt2a = V_bar_a * dt * dt;
+        Float Vdt2b = V_bar_b * dt * dt;
+
+        Vector12    Ga;
+        Vector12    Gb;
+        Matrix12x12 Ha12;
+        Matrix12x12 Hb12;
+
+        PDSB::dEdx(Ga, x0a, x1a, x2a, x3a, L0_a, h_bar_a, theta_bar_a, kappa_a);
+        PDSB::dEdx(Gb, x0b, x1b, x2b, x3b, L0_b, h_bar_b, theta_bar_b, kappa_b);
+        Ga *= Vdt2a;
+        Gb *= Vdt2b;
+        {
+            DoubletVectorAssembler DVA{G3s};
+            DVA.segment<StencilSize>(i0 * StencilSize).write(sa, Ga);
+            if(has1)
+                DVA.segment<StencilSize>(i1 * StencilSize).write(sb, Gb);
+        }
+
+        if(gradient_only)
