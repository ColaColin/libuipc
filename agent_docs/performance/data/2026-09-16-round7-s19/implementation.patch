+        for(int i = 0; i < 9; ++i)
+        {
+            auto& vva = wa(i);
+            vva       = vva < 0.0 ? 0.0 : vva;
+            auto& vvb = wb(i);
+            vvb       = vvb < 0.0 ? 0.0 : vvb;
+        }
+        // V diag(w) V^T upper triangle + mirror, both matrices in one nest
+#pragma unroll
+        for(int i = 0; i < 9; ++i)
+#pragma unroll
+            for(int j = i; j < 9; ++j)
+            {
+                Float suma = 0.0;
+                Float sumb = 0.0;
+#pragma unroll
+                for(int k = 0; k < 9; ++k)
+                {
+                    suma += Va(i, k) * wa(k) * Va(j, k);
+                    sumb += Vb(i, k) * wb(k) * Vb(j, k);
+                }
+                Hra(i, j) = suma;
+                Hra(j, i) = suma;
+                Hrb(i, j) = sumb;
+                Hrb(j, i) = sumb;
+            }
+            // mirrored back-assembly (SymAsm = 2 back half), both matrices
+#pragma unroll
+        for(int a = 0; a < 4; ++a)
+#pragma unroll
+            for(int b = a; b < 4; ++b)
+            {
+                Matrix3x3 Ba = Matrix3x3::Zero();
+                Matrix3x3 Bb = Matrix3x3::Zero();
+                for(int j = 0; j < 3; ++j)
+                {
+                    if(a >= nz[j])
+                        continue;
+                    for(int k = 0; k < 3; ++k)
+                    {
+                        if(b >= nz[k])
+                            continue;
+                        Ba += (h[j][a] * h[k][b]) * Hra.template block<3, 3>(3 * j, 3 * k);
+                        Bb += (h[j][a] * h[k][b]) * Hrb.template block<3, 3>(3 * j, 3 * k);
+                    }
+                }
+                Ha.template block<3, 3>(3 * a, 3 * b) = Ba;
+                Hb.template block<3, 3>(3 * a, 3 * b) = Bb;
+                if(a != b)
+                {
+                    Ha.template block<3, 3>(3 * b, 3 * a) = Ba.transpose();
+                    Hb.template block<3, 3>(3 * b, 3 * a) = Bb.transpose();
+                }
+            }
+    }
+}
