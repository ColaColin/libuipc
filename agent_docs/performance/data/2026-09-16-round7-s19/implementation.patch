+    /**
+     * @brief Two independent symmetric eigen-decompositions driven through
+     * one set of loops -- the s19 (round 7) ILP twin of `evd_tridiag_ql`.
+     *
+     * The plastic-hinge G/H kernels are launched at <<<ceil(n/256), 256>>> with
+     * 255 registers, i.e. at the machine's full register-limited occupancy of
+     * 256 threads/SM, and the scene's hinge count is ~93 % of that capacity,
+     * so no launch-geometry change can add concurrent chains (measured in
+     * agent_docs/performance/data/2026-09-16-round7-s19/). The one remaining
+     * mechanism for the QL's latency half (s16: the solve runs at 52 % of its
+     * FP64-issue floor) is to give each *thread* a second independent chain:
+     * the two solves' long-latency ops (divisions, hypots, dynamically
+     * indexed local-memory round trips of d/e/V) overlap inside one
+     * instruction stream without a warp switch.
+     *
+     * This function runs both matrices through the SAME loop nests: every
+     * fixed-trip loop carries one statement per matrix, and the serial QL
+     * do-while of tql2 is fused into one loop that advances whichever of the
+     * two chains is still unconverged (the rotation loop descends from
+     * max(mA, mB) - 1 with each chain's step guarded by `i < m`). Each
+     * chain's operations run in the same order as `evd_tridiag_ql` --
+     * interleaving is a scheduling change only -- so the per-matrix results
+     * are bit-identical to the single-matrix function (proved on device by
+     * the UIPC_PDSB_OCC_VERIFY probe over full simulation runs).
+     */
+    template <typename T, int N>
+    UIPC_GENERIC void evd_tridiag_ql_pair(const Eigen::Matrix<T, N, N>& Ma,
+                                          const Eigen::Matrix<T, N, N>& Mb,
+                                          Eigen::Vector<T, N>&          wa,
+                                          Eigen::Vector<T, N>&          wb,
+                                          Eigen::Matrix<T, N, N>&       Va,
+                                          Eigen::Matrix<T, N, N>&       Vb)
+    {
+        static_assert(N >= 2, "evd_tridiag_ql_pair needs N >= 2");
+        T VA[N][N];
+        T VB[N][N];
+        T dA[N];
+        T dB[N];
+        T eA[N];
+        T eB[N];
+#pragma unroll
+        for(int i = 0; i < N; ++i)
+#pragma unroll
+            for(int j = 0; j < N; ++j)
+            {
+                VA[i][j] = Ma(i, j);
+                VB[i][j] = Mb(i, j);
+            }
+
+            // --- Householder reduction to tridiagonal form (tred2), both
+            // matrices in the same loop nests
+#pragma unroll
+        for(int j = 0; j < N; ++j)
+        {
+            dA[j] = VA[N - 1][j];
+            dB[j] = VB[N - 1][j];
+        }
+        for(int i = N - 1; i > 0; --i)
+        {
+            T scaleA = 0.0;
+            T scaleB = 0.0;
+            T hA     = 0.0;
+            T hB     = 0.0;
+            for(int k = 0; k < i; ++k)
+            {
+                scaleA += abs(dA[k]);
+                scaleB += abs(dB[k]);
+            }
+            if(scaleA == 0.0)
+            {
+                eA[i] = dA[i - 1];
+                for(int j = 0; j < i; ++j)
+                {
+                    dA[j]    = VA[i - 1][j];
+                    VA[i][j] = 0.0;
+                    VA[j][i] = 0.0;
+                }
+            }
+            else
+            {
+                for(int k = 0; k < i; ++k)
+                {
+                    dA[k] /= scaleA;
+                    hA += dA[k] * dA[k];
+                }
+                T f = dA[i - 1];
+                T g = sqrt(hA);
+                if(f > 0)
+                    g = -g;
+                eA[i]     = scaleA * g;
+                hA        = hA - f * g;
+                dA[i - 1] = f - g;
+                for(int j = 0; j < i; ++j)
+                    eA[j] = 0.0;
+                for(int j = 0; j < i; ++j)
+                {
+                    f        = dA[j];
+                    VA[j][i] = f;
+                    g        = eA[j] + VA[j][j] * f;
+                    for(int k = j + 1; k <= i - 1; ++k)
+                    {
+                        g += VA[k][j] * dA[k];
+                        eA[k] += VA[k][j] * f;
+                    }
+                    eA[j] = g;
+                }
+                f = 0.0;
+                for(int j = 0; j < i; ++j)
+                {
+                    eA[j] /= hA;
+                    f += eA[j] * dA[j];
+                }
+                T hh = f / (hA + hA);
+                for(int j = 0; j < i; ++j)
+                    eA[j] -= hh * dA[j];
+                for(int j = 0; j < i; ++j)
+                {
+                    f = dA[j];
+                    g = eA[j];
+                    for(int k = j; k <= i - 1; ++k)
+                        VA[k][j] -= (f * eA[k] + g * dA[k]);
+                    dA[j]    = VA[i - 1][j];
+                    VA[i][j] = 0.0;
+                }
+            }
+            if(scaleB == 0.0)
+            {
+                eB[i] = dB[i - 1];
+                for(int j = 0; j < i; ++j)
+                {
+                    dB[j]    = VB[i - 1][j];
+                    VB[i][j] = 0.0;
+                    VB[j][i] = 0.0;
+                }
+            }
+            else
+            {
+                for(int k = 0; k < i; ++k)
+                {
+                    dB[k] /= scaleB;
+                    hB += dB[k] * dB[k];
+                }
+                T f = dB[i - 1];
+                T g = sqrt(hB);
+                if(f > 0)
+                    g = -g;
+                eB[i]     = scaleB * g;
+                hB        = hB - f * g;
+                dB[i - 1] = f - g;
+                for(int j = 0; j < i; ++j)
+                    eB[j] = 0.0;
+                for(int j = 0; j < i; ++j)
+                {
+                    f        = dB[j];
+                    VB[j][i] = f;
+                    g        = eB[j] + VB[j][j] * f;
+                    for(int k = j + 1; k <= i - 1; ++k)
+                    {
+                        g += VB[k][j] * dB[k];
+                        eB[k] += VB[k][j] * f;
+                    }
+                    eB[j] = g;
+                }
+                f = 0.0;
+                for(int j = 0; j < i; ++j)
+                {
+                    eB[j] /= hB;
+                    f += eB[j] * dB[j];
+                }
+                T hh = f / (hB + hB);
+                for(int j = 0; j < i; ++j)
+                    eB[j] -= hh * dB[j];
+                for(int j = 0; j < i; ++j)
+                {
+                    f = dB[j];
+                    g = eB[j];
+                    for(int k = j; k <= i - 1; ++k)
+                        VB[k][j] -= (f * eB[k] + g * dB[k]);
+                    dB[j]    = VB[i - 1][j];
+                    VB[i][j] = 0.0;
+                }
+            }
+            dA[i] = hA;
+            dB[i] = hB;
+        }
+        for(int i = 0; i < N - 1; ++i)
+        {
+            VA[N - 1][i] = VA[i][i];
+            VB[N - 1][i] = VB[i][i];
+            VA[i][i]     = 1.0;
+            VB[i][i]     = 1.0;
+            T hA         = dA[i + 1];
+            T hB         = dB[i + 1];
+            if(hA != 0.0)
+            {
+                for(int k = 0; k <= i; ++k)
+                    dA[k] = VA[k][i + 1] / hA;
+                for(int j = 0; j <= i; ++j)
+                {
+                    T g = 0.0;
+                    for(int k = 0; k <= i; ++k)
+                        g += VA[k][i + 1] * VA[k][j];
+                    for(int k = 0; k <= i; ++k)
+                        VA[k][j] -= g * dA[k];
+                }
+            }
+            if(hB != 0.0)
+            {
+                for(int k = 0; k <= i; ++k)
+                    dB[k] = VB[k][i + 1] / hB;
+                for(int j = 0; j <= i; ++j)
+                {
+                    T g = 0.0;
+                    for(int k = 0; k <= i; ++k)
+                        g += VB[k][i + 1] * VB[k][j];
+                    for(int k = 0; k <= i; ++k)
+                        VB[k][j] -= g * dB[k];
+                }
+            }
+            for(int k = 0; k <= i; ++k)
+            {
+                VA[k][i + 1] = 0.0;
+                VB[k][i + 1] = 0.0;
+            }
+        }
+#pragma unroll
+        for(int j = 0; j < N; ++j)
+        {
+            dA[j]        = VA[N - 1][j];
+            dB[j]        = VB[N - 1][j];
+            VA[N - 1][j] = 0.0;
+            VB[N - 1][j] = 0.0;
+        }
+        VA[N - 1][N - 1] = 1.0;
+        VB[N - 1][N - 1] = 1.0;
+        eA[0]            = 0.0;
+        eB[0]            = 0.0;
+
+        // --- implicit-shift QL (tql2), fused: one do-while advances both
+        // chains, each guarded by its own convergence; the rotation loop
+        // descends from max(mA, mB) - 1 so the two chains' rotation steps
+        // interleave.
+        for(int i = 1; i < N; ++i)
+        {
+            eA[i - 1] = eA[i];
+            eB[i - 1] = eB[i];
+        }
+        eA[N - 1]         = 0.0;
+        eB[N - 1]         = 0.0;
+        T           fA    = 0.0;
+        T           fB    = 0.0;
+        T           tst1A = 0.0;
+        T           tst1B = 0.0;
+        constexpr T eps   = 2.220446049250313e-16;
+        for(int l = 0; l < N; ++l)
+        {
+            T tlA = abs(dA[l]) + abs(eA[l]);
+            T tlB = abs(dB[l]) + abs(eB[l]);
+            if(tlA > tst1A)
+                tst1A = tlA;
+            if(tlB > tst1B)
+                tst1B = tlB;
+            int mA = l;
+            while(mA < N)
+            {
+                if(abs(eA[mA]) <= eps * tst1A)
+                    break;
+                ++mA;
+            }
+            int mB = l;
+            while(mB < N)
+            {
+                if(abs(eB[mB]) <= eps * tst1B)
+                    break;
+                ++mB;
+            }
+            bool actA  = mA > l;
+            bool actB  = mB > l;
+            int  iterA = 0;
+            int  iterB = 0;
+            // per-chain running rotation state (tql2 locals)
+            T cA = 1.0, sA = 0.0, c2A = 1.0, c3A = 1.0, s2A = 0.0, pA = 0.0;
+            T cB = 1.0, sB = 0.0, c2B = 1.0, c3B = 1.0, s2B = 0.0, pB = 0.0;
+            T el1A = 0.0, dl1A = 0.0, el1B = 0.0, dl1B = 0.0;
+            while(actA || actB)
+            {
+                if(actA)
+                {
+                    ++iterA;
+                    T g = dA[l];
+                    T p = (dA[l + 1] - g) / (2.0 * eA[l]);
+                    T r = hypot(p, T(1.0));
+                    if(p < 0)
+                        r = -r;
+                    dA[l]     = eA[l] / (p + r);
+                    dA[l + 1] = eA[l] * (p + r);
+                    dl1A      = dA[l + 1];
+                    T h       = g - dA[l];
+                    for(int i = l + 2; i < N; ++i)
+                        dA[i] -= h;
+                    fA += h;
+                    pA   = dA[mA];
+                    cA   = 1.0;
+                    c2A  = cA;
+                    c3A  = cA;
+                    el1A = eA[l + 1];
+                    sA   = 0.0;
+                    s2A  = 0.0;
+                }
+                if(actB)
+                {
+                    ++iterB;
+                    T g = dB[l];
+                    T p = (dB[l + 1] - g) / (2.0 * eB[l]);
+                    T r = hypot(p, T(1.0));
+                    if(p < 0)
+                        r = -r;
+                    dB[l]     = eB[l] / (p + r);
+                    dB[l + 1] = eB[l] * (p + r);
+                    dl1B      = dB[l + 1];
+                    T h       = g - dB[l];
+                    for(int i = l + 2; i < N; ++i)
+                        dB[i] -= h;
+                    fB += h;
+                    pB   = dB[mB];
+                    cB   = 1.0;
+                    c2B  = cB;
+                    c3B  = cB;
+                    el1B = eB[l + 1];
+                    sB   = 0.0;
+                    s2B  = 0.0;
+                }
+                // fused rotation loop: chain A participates while it is still
+                // active and i < mA, chain B likewise; both descend to the
+                // shared l. (The activity flag in the guard is load-bearing:
+                // a chain that converged at an earlier iteration of the fused
+                // do-while must not keep rotating while the other finishes.)
+                int mhi = actA ? mA : l;
+                if(actB && mB > mhi)
+                    mhi = mB;
+                for(int i = mhi - 1; i >= l; --i)
+                {
+                    if(actA && i < mA)
+                    {
+                        T g       = cA * eA[i];
+                        T h       = cA * pA;
+                        T r       = hypot(pA, eA[i]);
+                        c3A       = c2A;
+                        c2A       = cA;
+                        s2A       = sA;
+                        eA[i + 1] = sA * r;
+                        sA        = eA[i] / r;
+                        cA        = pA / r;
+                        pA        = cA * dA[i] - sA * g;
+                        dA[i + 1] = h + sA * (cA * g + sA * dA[i]);
+#pragma unroll
+                        for(int k = 0; k < N; ++k)
+                        {
+                            h            = VA[k][i + 1];
+                            VA[k][i + 1] = sA * VA[k][i] + cA * h;
+                            VA[k][i]     = cA * VA[k][i] - sA * h;
+                        }
+                    }
+                    if(actB && i < mB)
+                    {
+                        T g       = cB * eB[i];
+                        T h       = cB * pB;
+                        T r       = hypot(pB, eB[i]);
+                        c3B       = c2B;
+                        c2B       = cB;
+                        s2B       = sB;
+                        eB[i + 1] = sB * r;
+                        sB        = eB[i] / r;
+                        cB        = pB / r;
+                        pB        = cB * dB[i] - sB * g;
+                        dB[i + 1] = h + sB * (cB * g + sB * dB[i]);
+#pragma unroll
+                        for(int k = 0; k < N; ++k)
+                        {
+                            h            = VB[k][i + 1];
+                            VB[k][i + 1] = sB * VB[k][i] + cB * h;
+                            VB[k][i]     = cB * VB[k][i] - sB * h;
+                        }
+                    }
+                }
+                if(actA)
+                {
+                    T p   = -sA * s2A * c3A * el1A * eA[l] / dl1A;
+                    eA[l] = sA * p;
+                    dA[l] = cA * p;
+                    actA  = abs(eA[l]) > eps * tst1A && iterA < 40;
+                }
+                if(actB)
+                {
+                    T p   = -sB * s2B * c3B * el1B * eB[l] / dl1B;
+                    eB[l] = sB * p;
+                    dB[l] = cB * p;
+                    actB  = abs(eB[l]) > eps * tst1B && iterB < 40;
+                }
+            }
+            dA[l] += fA;
+            dB[l] += fB;
+            eA[l] = 0.0;
+            eB[l] = 0.0;
+        }
+
+#pragma unroll
+        for(int i = 0; i < N; ++i)
+        {
+            wa(i) = dA[i];
+            wb(i) = dB[i];
+        }
+#pragma unroll
+        for(int i = 0; i < N; ++i)
+#pragma unroll
+            for(int j = 0; j < N; ++j)
+            {
+                Va(i, j) = VA[i][j];
+                Vb(i, j) = VB[i][j];
+            }
+    }
