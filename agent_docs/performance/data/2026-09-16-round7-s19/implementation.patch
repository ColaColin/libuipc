+// perf/round7 (s19): the two-matrix twin of the blocked 4x3 projection, for
+// the plastic-hinge kernels' two-hinges-per-thread arm (UIPC_PDSB_OCC). The
+// blocked kernel sits at 255 registers = the machine's full 256-thread/SM
+// register-limited occupancy, and crease-press supplies ~93 % of that
+// capacity in hinges, so the QL's latency half (s16: the solve runs at 52 %
+// of its FP64-issue floor) cannot be folded by occupancy -- the only
+// remaining mechanism is a second independent chain per *thread*. This
+// helper projects two Hessians through one set of loop nests: the assembly
+// and back-assembly carry both matrices' statements in the same (unrolled)
+// nests, and the eigen-solve is `evd_tridiag_ql_pair`, the fused do-while
+// form of tql2. Every per-matrix operation runs with the same expressions
+// in the same order as the single-matrix helper, so the two outputs are
+// bit-identical to calling the single helper twice (proved on device by
+// UIPC_PDSB_OCC_VERIFY over full runs). Solver = 0 (Eigen) and the
+// non-default SymAsm arms fall back to two sequential single-matrix calls:
+// the pair arm rides only the default <1, 1, 2> instantiation.
+template <int Solver = 0, int SymAsm = 2>
+inline UIPC_GENERIC void make_spd_translation_free_4x3_blocked_pair(Matrix12x12& Ha,
+                                                                    Matrix12x12& Hb)
+{
+    if constexpr(Solver != 1 || SymAsm != 2)
+    {
+        make_spd_translation_free_4x3_blocked<Solver, SymAsm>(Ha);
+        make_spd_translation_free_4x3_blocked<Solver, SymAsm>(Hb);
+        return;
+    }
+    else
+    {
+        constexpr Float            r2      = 0.70710678118654752440;
+        constexpr Float            r6      = 0.40824829046386301637;
+        constexpr Float            r12     = 0.28867513459481288225;
+        constexpr Float            h[3][4] = {{r2, -r2, 0.0, 0.0},
+                                              {r6, r6, -2.0 * r6, 0.0},
+                                              {r12, r12, r12, -3.0 * r12}};
+        constexpr int              nz[3]   = {2, 3, 4};
+        Eigen::Matrix<Float, 9, 9> Hra;
+        Eigen::Matrix<Float, 9, 9> Hrb;
+        // dead-triangle cut assembly (SymAsm = 2 forward half), both matrices
+        // in the same unrolled nest so their FMAs interleave
+        Hra.setZero();
+        Hrb.setZero();
+#pragma unroll
+        for(int j = 0; j < 3; ++j)
+#pragma unroll
+            for(int k = 0; k <= j; ++k)
+            {
+                if(j == k)
+                {
+#pragma unroll
+                    for(int p = 0; p < 3; ++p)
+#pragma unroll
+                        for(int q = 0; q <= p; ++q)
+                        {
+                            Float sa = 0.0;
+                            Float sb = 0.0;
+#pragma unroll
+                            for(int a = 0; a < nz[j]; ++a)
+#pragma unroll
+                                for(int b = 0; b < nz[j]; ++b)
+                                {
+                                    sa += (h[j][a] * h[j][b]) * Ha(3 * a + p, 3 * b + q);
+                                    sb += (h[j][a] * h[j][b]) * Hb(3 * a + p, 3 * b + q);
+                                }
+                            Hra(3 * j + p, 3 * j + q) = sa;
+                            Hrb(3 * j + p, 3 * j + q) = sb;
+                        }
+                    continue;
+                }
+                Matrix3x3 Ba = Matrix3x3::Zero();
+                Matrix3x3 Bb = Matrix3x3::Zero();
+                for(int a = 0; a < nz[j]; ++a)
+                    for(int b = 0; b < nz[k]; ++b)
+                    {
+                        Ba += (h[j][a] * h[k][b]) * Ha.template block<3, 3>(3 * a, 3 * b);
+                        Bb += (h[j][a] * h[k][b]) * Hb.template block<3, 3>(3 * a, 3 * b);
+                    }
+                Hra.template block<3, 3>(3 * j, 3 * k) = Ba;
+                Hrb.template block<3, 3>(3 * j, 3 * k) = Bb;
+            }
