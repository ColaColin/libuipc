+
+    // perf/round7 (s04): the Gauss-Newton strain-plastic Hessian -- the
+    // plastic-hinge analogue of sym::discrete_shell_bending::ddEddx_gauss_newton
+    // (round 6 s02) and sym::dahl_friction_discrete_shell_bending::
+    // dEdx_ddEddx_gauss_newton (round 7 s03). The energy is
+    //
+    //   E(theta) = (L0 * kappa / h_bar) * del^2,   del = wrap(theta - theta_bar),
+    //
+    // a function of the dihedral angle alone with the committed plastic angle
+    // theta_bar as a per-edge frame constant (written once per accepted frame
+    // by update_plastic_state; the yield threshold and hardening modulus only
+    // decide *where* theta_bar moves, they do not enter the energy). So
+    //
+    //   ddEddtheta = 2 * L0 * kappa / h_bar
+    //
+    // is a CONSTANT -- no dependence on theta, on theta_bar, or on the yield
+    // state at all -- and it is non-negative for every reachable input:
+    // L0 is a rest edge length (> 0), h_bar = A / (3 L0) a rest height
+    // (> 0), kappa the bending stiffness (>= 0; the physical formula is
+    // E_young * h^3 / (12 (1 - nu^2)), and the constitution front-end
+    // validates it for finiteness). Proved on device over 2x200 000
+    // randomised reachable hinges (theta placed exactly across +-pi;
+    // theta_bar drawn by chaining the real update_plastic_state, directly
+    // over +-pi, and fresh): 0 samples with ddEddtheta < 0, minimum
+    // +1.36e-6 = the smallest kappa draw of the sweep; the split identity
+    // H_full == ddEddtheta*g*g^T + dEdtheta*hess(theta) reproduces to
+    // 1.7e-16 (agent_docs/performance/data/2026-09-15-round7-s04/).
+    //
+    // So ddEddtheta * dthetadx dthetadx^T is PSD by construction and the
+    // indefinite dEdtheta * hess(theta) term -- this Hessian's only source of
+    // indefiniteness -- can be dropped exactly as on the plain hinge and the
+    // dahl hinge: same energy, same gradient, different Newton search
+    // direction. dihedral_angle_hessian() is never evaluated and no
+    // eigen-solve runs.
+    //
+    // The max(ddEddtheta, 0) clamp is inert on the reachable state space (the
+    // coefficient is a single non-negative product, not a sum, so it cannot
+    // cancel); it only guards the imported-state path -- the front-end
+    // validates bending_stiffness for finiteness alone, not sign, and a
+    // negative kappa import would otherwise make the GN rank-1 term negative
+    // (measured: 99.4 % of such imports would go negative, min -8.4e2;
+    // 0 activations on reachable samples).
+    //
+    // G is computed by the identical expressions, in the same order, as
+    // dEdx() above (one shared evaluation of the dihedral angle and the angle
+    // gradient serves both), so the gradient is exact; only the Hessian model
+    // changes. `scale` (V_bar * dt^2) is folded into the rank-1 coefficient
+    // instead of scaling the assembled matrix afterwards, and the fill is an
+    // explicit mirrored loop so H is *exactly* symmetric.
+    inline UIPC_GENERIC void dEdx_ddEddx_gauss_newton(Vector12&    G,
+                                                      Matrix12x12& H,
+                                                      const Vector3& x0,
+                                                      const Vector3& x1,
+                                                      const Vector3& x2,
+                                                      const Vector3& x3,
+                                                      Float          L0,
+                                                      Float          h_bar,
+                                                      Float          theta_bar,
+                                                      Float          kappa,
+                                                      Float          scale)
+    {
+        namespace PDSB = sym::strain_plastic_discrete_shell_bending;
+        Float theta    = 0.0;
+        Float delta    = 0.0;
+        if(!PDSB::try_angle_delta(x0, x1, x2, x3, theta_bar, theta, delta))
+        {
+            G.setZero();
+            H.setZero();
+            return;
+        }
+
+        // G: the identical expressions, in the same order, as dEdx().
+        Float dEdtheta;
+        PDSB::dEdtheta(dEdtheta, kappa, theta_bar + delta, theta_bar, L0, h_bar);
+
+        Float ddEddtheta;
+        PDSB::ddEddtheta(ddEddtheta, kappa, theta_bar + delta, theta_bar, L0, h_bar);
+
+        Vector12 dthetadx;
+        dihedral_angle_gradient(x0, x1, x2, x3, dthetadx);
+
+        G = dEdtheta * dthetadx;
+
+        const Float c = PDSB::max_value(ddEddtheta, Float(0)) * scale;
+#pragma unroll
+        for(int i = 0; i < 12; ++i)
+        {
+            const Float ci = c * dthetadx(i);
+            H(i, i)        = ci * dthetadx(i);
+#pragma unroll
+            for(int j = i + 1; j < 12; ++j)
+            {
+                const Float v = ci * dthetadx(j);
+                H(i, j)       = v;
+                H(j, i)       = v;
+            }
+        }
+    }
 }  // namespace sym::strain_plastic_discrete_shell_bending
 }  // namespace uipc::backend::cuda
